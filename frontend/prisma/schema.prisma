generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ChatSession {
  id          String        @id @default(cuid())
  clerkUserId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Booking {
  id                 String   @id @default(cuid())
  name               String
  phone              String
  email              String
  service            String
  date               String
  paymentMethod      String
  status             String   @default("pending")
  clerkUserId        String?
  mpesaCheckoutId    String?
  mpesaReceiptNumber String?
  paidAmount         String?
  attachmentUrl      String?
  attachmentPublicId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("bookings")
}

model Review {
  id          String   @id @default(cuid())
  clerkUserId String?
  authorName  String
  authorEmail String?
  rating      Int
  title       String
  body        String
  service     String?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("reviews")
}

model Quote {
  id             String   @id @default(cuid())
  clerkUserId    String?
  name           String
  email          String
  phone          String
  service        String
  woodSpecies    String?
  metalFinish    String?
  dimensions     String?
  budget         String
  timeline       String
  description    String
  attachmentUrl  String?
  status         String   @default("new")
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("quotes")
}

model Order {
  id                 String      @id @default(cuid())
  clerkUserId        String?
  name               String
  email              String
  phone              String
  address            String?
  items              Json
  totalAmount        Int
  paymentMethod      String
  status             String      @default("pending")
  mpesaCheckoutId    String?
  mpesaReceiptNumber String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("orders")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Athlete {
  id            String          @id @default(cuid())
  parentClerkId String
  name          String
  ageGroup      String
  sport         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  progress      ProgressEntry[]

  @@map("athletes")
}

model ProgressEntry {
  id         String   @id @default(cuid())
  athleteId  String
  metric     String
  value      String
  notes      String?
  recordedAt DateTime @default(now())
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("progress_entries")
}


model InstitutionBooking {
  id             String    @id @default(cuid())
  schoolName     String
  contactName    String
  contactEmail   String
  contactPhone   String?
  studentCount   String?
  program        String
  proposedDate   String?
  notes          String?
  status         String    @default("pending") // pending | contract_sent | signed | cancelled
  contractText   String?
  signedByName   String?
  signedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("institution_bookings")
}

model SessionOption {
  id        String   @id @default(cuid())
  name      String
  duration  String
  price     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session_options")
}

model EquipmentItem {
  id           String   @id @default(cuid())
  name         String
  description  String
  imageUrl     String
  pricePerDay  Int
  category     String
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("equipment_items")
}
